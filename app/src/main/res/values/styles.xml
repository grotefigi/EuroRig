        <item name="android:textColorPrimary">#0F172A</item>
        <item name="android:textColorSecondary">#475569</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F1F5F9</item>
        <item name="android:navigationBarColor">#F1F5F9</item>
        <item name="android:windowBackground">#F1F5F9</item>
    </style>
</resources>
