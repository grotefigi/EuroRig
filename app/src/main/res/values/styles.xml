<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#4C9AFF</item>
        <item name="android:colorControlHighlight">#40FFFFFF</item>
        <item name="android:colorButtonNormal">#20242C</item>
        <item name="android:colorBackground">#191C22</item>
        <item name="android:textColorPrimary">#F8FAFC</item>
        <item name="android:textColorSecondary">#9AA3B2</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#020617</item>
        <item name="android:navigationBarColor">#020617</item>
        <item name="android:windowActionModeOverlay">true</item>
