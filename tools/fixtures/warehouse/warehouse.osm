<!-- EuroRig controlled warehouse fixture. Deliberately tiny and fully synthetic.
     Geometry: a public east-west road with a 3.5 m bridge, a one-way public bypass around it,
     warehouse A served by two delivery-only approaches, warehouse B behind a private drive,
     warehouse C on a public service road.
     Coordinates are a 0.001-degree grid (~111 m north-south, ~79 m east-west at lat 45). -->
<osm version="0.6" generator="eurorig-fixture">
  <!-- main road, west to east -->
  <node id="1001" lat="45.0000" lon="25.0000"/>
  <node id="1002" lat="45.0000" lon="25.0010"/>
