  <node id="1009" lat="45.0008" lon="25.0018"/>
  <!-- warehouse B gate, private drive -->
  <node id="1010" lat="44.9975" lon="25.0050"/>
  <!-- warehouse C, public service road -->
  <node id="1011" lat="45.0028" lon="25.0010"/>

  <way id="2001">
